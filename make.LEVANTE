#!/bin/bash
# Kompilierung von WAM mit ifort mit mpi
#ccccccccccccccccccccccccccccccccccccccc
#	cd in das Verzeichnis von wk.make
#	./wk.make [first]

#### LEVANTE - OpenMPI (wk.make.LEVANTE) ####
module purge
module load openmpi/4.1.2-intel-2021.5.0
module load netcdf-c/4.8.1-openmpi-4.1.2-intel-2021.5.0
module load netcdf-fortran/4.5.3-openmpi-4.1.2-intel-2021.5.0
#module load netcdf-fortran/4.5.3-intel-2021.5.0
#module load netcdf-c/4.8.1-intel-2021.5.0

export FC=mpifort
export FFLAGS="-heap-arrays 64 -fp-model precise" #"-heap-arrays 64 -g -traceback -check bounds"

export MPIHOME=/sw/spack-levante/openmpi-4.1.2-yfwe6t
export NETCDFHOME=/sw/spack-levante/netcdf-fortran-4.5.3-k6xq5g  # ref to module netcdf-fortran/4.5.3-openmpi-4.1.2-intel-2021.5.0
#export NETCDFHOME=/sw/spack-levante/netcdf-fortran-4.5.3-pvmcx6  # ref to module netcdf-fortran/4.5.3-intel-2021.5.0
NCDFIN="-I${NETCDFHOME}/include"
NCDFLIB="-L${NETCDFHOME}/lib -Wl,-rpath,${NETCDFHOME}/lib"
NCDFFLAGS="-lnetcdff"
#NCDFIN=$(nf-config --fflags)
#NCDFLIB=$(nf-config --flibs)
#NCDFLIB="-L/sw/spack-levante/netcdf-fortran-4.5.3-k6xq5g/lib -lnetcdff -Wl,-rpath,/sw/spack-levante/netcdf-fortran-4.5.3-k6xq5g/lib -L/sw/spack-levante/netcdf-c-4.8.1-2k3cmu/lib -Wl,-rpath,/sw/spack-levante/netcdf-c-4.8.1-2k3cmu/lib -L/sw/spack-levante/hdf5-1.12.1-tvymb5/lib -Wl,-rpath,/sw/spack-levante/gcc-11.2.0-7jcqrc/lib64 -Wl,-rpath,/sw/spack-levante/hdf5-1.12.1-tvymb5/lib -Wl,-rpath,/sw/spack-levante/netcdf-c-4.8.1-2k3cmu/lib -lnetcdf -lhdf5_hl -lhdf5 -lnetcdf"

export LDOPT="${NCDFIN} ${NCDFLIB} ${NCDFFLAGS}"

#export LC_ALL=C
#export FFLAGS="$FFLAGS -I/sw/spack-levante/netcdf-fortran-4.5.3-k6xq5g/include"
export OASISLIB=/home/g/g260237/Codes/oasis3-mct_forGCOAST_MR/oasis3-mct_LEVANTE/lib


#### A piori choice of Input Data Formats ####
(cd src/chief
 #-> 'SWAMP' Test case
 ln -sf read_wind_input_arno.f90                           read_wind_input.f90
 ln -sf read_boundary_input.f90_bound_from_current_version read_boundary_input.f90
 ln -sf read_topo_input_arno.f90                           read_topo_input.f90
 ln -sf read_current_input_arno.f90                        read_current_input.f90
 #-> 'GCOAST' setup
 #ln -sf read_wind_input_DWD.f90                  read_wind_input.f90
 #ln -sf read_boundary_input.f90_bound_from_4.5.3 read_boundary_input.f90
 #ln -sf read_topo_input_getm.f90                 read_topo_input.f90
 #ln -sf read_current_input_getm.f90              read_current_input.f90
 #-> Others
 #ln -sf read_wind_input_netcdf_start_after00.f90 read_wind_input.f90
)


#### Lets make it! ####
echo export PRODADMDIR=$PWD>mk/.dirset
mkdir -p abs obj

if [ "$1" == clean ];then
	cp -ra ./obj/Makefile ./
	rm ./abs/* ./obj/*
	cp -ra Makefile ./obj/

elif [ "$1" == first ];then
	echo 'FIRST'
	cd mk
	./create_binaries first
	rm -f ../obj/wam_oasis_module.o
else
	if [ "$1" == off ];then
		echo 'OASIS OFF'
		#(cd src/mod; ln -sf wam_oasis_inactive_module     wam_oasis_module    )
                (cd src/mod; ln -sf wam_oasis_inactive_module.f90 wam_oasis_module.f90)
		export LIBS=${LDOPT}
		shift
	else
		echo 'OASIS ON'
		if [ -d $OASISLIB ];then
			export FFLAGS="$FFLAGS -I ${OASISLIB%/*}/build/lib/psmile.MPI1"
			export LIBS="${LDOPT} -L$OASISLIB -lpsmile.MPI1 -lmct -lmpeu -lscrip"
			#export LIBS="${LDOPT} -I${OASISLIB%/*}/build/lib/psmile.MPI1 -L$OASISLIB -lpsmile.MPI1 -lmct -lmpeu -lscrip"
		else
			export OASISLIB=
		fi
		echo $OASISLIB
		#(cd src/mod; ln -sf wam_oasis_active_module     wam_oasis_module    )
		(cd src/mod; ln -sf wam_oasis_active_module.f90 wam_oasis_module.f90)
	fi
	cd obj
	#make --debug=b ../abs/wam
	#FCFLAGS=-O3 make --debug=b ${1-../abs/wam}
	make --debug=b ${1-../abs/wam}
fi
